# Copy this file to .env.local and fill in the values you need.
# See DATABASE_SETUP.md for detailed setup instructions.

# --- Database ---
# Postgres connection string. If unset (or doesn't start with "postgres"), the app falls back
# to a local SQLite database at ./sqlite.db — fine for quick local exploration, not production.
DATABASE_URL=postgresql://postgres:password@localhost:5432/openway

# --- Sessions & security ---
# Required in production; must be at least 32 characters. Used to sign session cookies.
SESSION_SECRET=replace-with-a-random-32-plus-character-secret

# Optional but recommended: a separate secret used to encrypt 2FA secrets/backup codes.
# If unset, this is derived from SESSION_SECRET instead, which means rotating SESSION_SECRET
# will make existing users' 2FA data undecryptable.
TWO_FACTOR_ENCRYPTION_KEY=replace-with-another-random-secret

# Comma-separated list of origins allowed to make credentialed cross-origin requests to the API.
# Leave unset if the frontend and API are always served from the same origin.
ALLOWED_ORIGINS=

# --- Email (Resend) ---
# Used for password reset and email verification. If either is unset, emails are logged to the
# console in development and silently not sent in production.
RESEND_API_KEY=
RESET_EMAIL_FROM=

# --- Server ---
# Port the Express server listens on (serves both the API and, in dev, the Vite client).
PORT=5000
NODE_ENV=development

# Set to "true" to seed the database with demo places/blog/FAQ/events on startup if it's empty.
OPENWAY_SEED_ON_STARTUP=false
